# Deny the repository by default. The Node image only needs the web app,
# legacy web-tool sources, and the exact extension files packaged by
# cloud-tool/scripts/sync-web-tool.mjs.
*

!cloud-tool/
!cloud-tool/**
!web-tool/
!web-tool/**
!xhs/
!xhs/**
!vendor/
!vendor/xlsx.full.min.js

!adstar-page-hook.js
!pgy-page-hook.js
!juguang-page-hook.js
!xhs-platform-content.js
!manifest.json
!README_V2.md
!diagnosis-popup.html
!diagnosis-popup.js
!diagnosis-spec.js
!background.js
!content-script.js
!dmp-content-script.js
!dmp-crowd-presets.json
!dmp-page-hook.js
!page-hook.js
!rules.js
!sycm-content-script.js
!web-tool-bridge.js
!xinghe-content-script.js
!wxt-report-content.js
!wxt-report-page-hook.js
!wxt-report-response-hook.js
!wxt-report-trace.js

# Re-exclude build products, local tool state, credentials, and all possible
# persistence or migration artifacts after the cloud-tool allow-list above.
cloud-tool/node_modules/
cloud-tool/.git/
cloud-tool/dist/
cloud-tool/.next/
cloud-tool/.vinext/
cloud-tool/.wrangler/
cloud-tool/.data/
cloud-tool/.data/**
cloud-tool/.dev.vars
cloud-tool/.env
cloud-tool/.env.*
cloud-tool/outputs/
cloud-tool/work/
cloud-tool/tests/

**/*.sqlite
**/*.sqlite3
**/*.sqlite-wal
**/*.sqlite-shm
**/*.db
**/*.db-wal
**/*.db-shm
**/objects/
**/objects/**
**/*.tbmig
**/backup/
**/backup/**
**/backups/
**/backups/**
**/*.bak
**/*.backup
**/*.pem
**/*.key
**/*.log
