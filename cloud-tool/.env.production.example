# Public HTTPS origin used for same-origin write protection.
APP_PUBLIC_ORIGIN=https://tbdata.example.com

# Loopback port consumed by the ECS host's existing reverse proxy.
APP_PORT=3401

# At least 32 random characters. Preserve the current value when migrating
# existing password hashes.
PASSWORD_PEPPER=replace-with-existing-or-new-random-secret

# Base64-encoded 32-byte key. Preserve the current value when migrating run
# history objects.
RUN_DATA_KEY=replace-with-base64-encoded-32-byte-key

# At least 24 high-entropy random characters. This may be rotated after owner setup.
BOOTSTRAP_TOKEN=replace-with-one-time-bootstrap-secret

# Emergency owner recovery is intentionally disabled by default. Provision its
# short-lived OWNER_RECOVERY_* values only for an active recovery incident, as
# documented in README.md, then remove them immediately after success/expiry.
