# Copy this server block into the ECS host's existing Nginx configuration.
# Keep TLS certificate management in the host's current certificate system.
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name tbdata.aizicheng.com;

  # Replace these with the paths already managed on this host.
  ssl_certificate /etc/nginx/certs/tbdata.aizicheng.com/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/tbdata.aizicheng.com/privkey.pem;

  client_max_body_size 30m;

  location / {
    proxy_pass http://127.0.0.1:3401;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 300s;
  }
}

# Add this redirect only if the host does not already provide a shared HTTP
# redirect server for the domain.
server {
  listen 80;
  listen [::]:80;
  server_name tbdata.aizicheng.com;
  return 301 https://$host$request_uri;
}
